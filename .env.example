# Flask & Security Configuration
SECRET_KEY=campuscare_super_secret_jwt_key_2026_production_ready!
PORT=5000
DEBUG=True

# SQL Server Database Configuration
# Uses Windows Authentication (Trusted_Connection) by default.
# For SQL Server Authentication, set DB_TRUSTED_CONNECTION=no and provide DB_USER and DB_PASSWORD.
DB_SERVER=localhost
DB_NAME=CampusCareDB
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes
DB_USER=
DB_PASSWORD=

# Business Logic
ALLOWED_EMAIL_DOMAIN=kiet.edu
MAX_CONTENT_LENGTH=10485760  # 10 MB upload limit
UPLOAD_FOLDER=backend/uploads
