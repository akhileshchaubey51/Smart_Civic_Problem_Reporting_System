# Environment Variables & Secrets
.env
.env.local
*.env

# Python byte-compiled / cache files
__pycache__/
*.py[cod]
*.class
*.pyo
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Scratch & Temporary Testing Files & Databases
scratch/
tests/scratch/
